{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rsModMaster",
  "identifier": "io.github.andersou.rsmodmaster",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rsModMaster",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0d1018",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
